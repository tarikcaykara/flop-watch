# flop-watch: copy to .env, then run `docker compose up -d` (architecture §9, §10).

# Grafana, published only on 127.0.0.1. Change the password before you expose Grafana anywhere.
GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_PORT=3000

# The collector. Every variable below is commented out at its default, so the code's defaults
# apply; uncomment a line to override it. An empty faucet or explorer URL disables that probe.
# FLOPWATCH_NETWORKS=devnet,testnet
# FLOPWATCH_HOST=0.0.0.0
# A changed port needs the same change in prometheus/prometheus.yml.
# FLOPWATCH_PORT=10063
# FLOPWATCH_LOG_LEVEL=info

# Devnet
# FLOPWATCH_DEVNET_RPC_WS=wss://rpc.devnet.flop.network
# FLOPWATCH_DEVNET_RPC_HTTP=https://rpc.devnet.flop.network
# FLOPWATCH_DEVNET_FAUCET_URL=https://faucet.devnet.flop.network
# FLOPWATCH_DEVNET_EXPLORER_API_URL=https://explorer.devnet.flop.network/api
# FLOPWATCH_DEVNET_EXPECTED_GENESIS=0x99c172c095340ace980631f9123544c6bebd4839f3437e463533422d8be2d631

# Testnet
# FLOPWATCH_TESTNET_RPC_WS=wss://testnet.flop.network
# FLOPWATCH_TESTNET_RPC_HTTP=https://testnet.flop.network
# FLOPWATCH_TESTNET_FAUCET_URL=https://faucet.flop.network
# FLOPWATCH_TESTNET_EXPLORER_API_URL=https://testnet.flopscan.io/api
# FLOPWATCH_TESTNET_EXPECTED_GENESIS=0x918abd58fb16306b30ef3886514cfaebffecb4de43e82b6f8ec4795c43cfd800
